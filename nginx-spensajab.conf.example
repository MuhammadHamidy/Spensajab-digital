# ==============================================================
# SPENSAJAB UPSTREAM & SERVER BLOCK UNTUK /opt/spenspra/nginx/nginx.conf
# ==============================================================

# 1. Masukkan kedua upstream ini di bagian "Persistent Upstream Connections" (sekitar baris 80)
  upstream spensajab_frontend {
    server spensajab-frontend:3000;
    keepalive 32;
  }
  upstream spensajab_api {
    server spensajab-backend:8080;
    keepalive 32;
  }

# 2. Masukkan blok server ini di bagian paling bawah sebelum kurung kurawal penutup "}" terakhir dari "http { ... }"
  # ============================================================================
  # 5. Spensajab Presensi Digital Service
  # ============================================================================
  server {
    listen 80;
    listen 443 ssl;
    server_name spensajab.tech www.spensajab.tech sepnsajab.tech www.sepnsajab.tech;

    # Static Assets Cache (Next.js Chunks & Public Files)
    location /_next/static/ {
      proxy_cache STATIC;
      proxy_pass http://spensajab_frontend;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_ignore_headers Set-Cookie;
      proxy_hide_header Set-Cookie;
      expires 365d;
      add_header Cache-Control "public, max-age=31536000, immutable";
      add_header X-Cache-Status $upstream_cache_status;
    }

    # API Backend (Go Fiber)
    location /api/ {
      proxy_pass http://spensajab_api;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;

      # Timeout untuk import file Excel besar
      proxy_connect_timeout 60s;
      proxy_send_timeout 60s;
      proxy_read_timeout 60s;
    }

    # Frontend Web (Next.js)
    location / {
      proxy_pass http://spensajab_frontend;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
  }
